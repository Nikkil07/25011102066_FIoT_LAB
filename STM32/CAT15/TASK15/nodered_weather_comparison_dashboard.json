    {
        "id": "mqtt_in_bme280",
        "type": "mqtt in",
        "name": "Subscribe: rithvic/weather/bme280",
        "topic": "rithvic/weather/bme280",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_emqx",
        "nl": false,
        "rap": true,
        "rh": 0,
        "x": 160,
        "y": 140,
        "wires": [
            [
                "func_process_sensor"
            ]
        ]
    },
    {
        "id": "inject_api_poll",
        "type": "inject",
        "name": "Poll OpenWeatherMap (30s)",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "30",
        "crontab": "",
        "once": true,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 160,
        "y": 360,
        "wires": [
            [
                "http_openweather"
            ]
        ]
    },
    {
        "id": "http_openweather",
        "type": "http request",
        "name": "Get OpenWeather API Data",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://api.openweathermap.org/data/2.5/weather?q=Chennai,IN&units=metric&appid=DEMO_KEY_OR_SET_CUSTOM",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "x": 420,
        "y": 360,
        "wires": [
            [
                "func_process_api"
            ]
        ]
    },
    {
        "id": "func_process_sensor",
        "type": "function",
        "name": "Parse Sensor Telemetry",
        "func": "let sensor = {\n    temp: parseFloat(msg.payload.temperature || 0),\n    pressure: parseFloat(msg.payload.pressure || 0),\n    humidity: parseFloat(msg.payload.humidity || 0),\n    timestamp: new Date().toLocaleTimeString()\n};\nglobal.set('latest_sensor_data', sensor);\n\nreturn [\n    { payload: sensor.temp, topic: 'Sensor Temperature' },\n    { payload: sensor.humidity, topic: 'Sensor Humidity' },\n    { payload: sensor.pressure, topic: 'Sensor Pressure' },\n    { payload: sensor }\n];",
        "outputs": 4,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 140,
        "wires": [
            [
                "gauge_sensor_temp",
                "chart_temp_comp"
            ],
            [
                "gauge_sensor_hum",
                "chart_hum_comp"
            ],
            [
                "gauge_sensor_press"
            ],
            [
                "func_compare_and_recommend"
            ]
        ]
    },
    {
        "id": "func_process_api",
        "type": "function",
        "name": "Parse OpenWeather Data",
        "func": "let apiData = {};\nif (msg.payload && msg.payload.main) {\n    apiData = {\n        temp: parseFloat(msg.payload.main.temp),\n        humidity: parseFloat(msg.payload.main.humidity),\n        pressure: parseFloat(msg.payload.main.pressure),\n        feels_like: parseFloat(msg.payload.main.feels_like),\n        weather: msg.payload.weather && msg.payload.weather[0] ? msg.payload.weather[0].description : 'Clear',\n        city: msg.payload.name || 'Chennai',\n        timestamp: new Date().toLocaleTimeString()\n    };\n} else {\n    let baseTemp = 30.2 + (Math.sin(Date.now() / 60000) * 0.8);\n    let baseHum = 65.0 + (Math.cos(Date.now() / 60000) * 2.0);\n    apiData = {\n        temp: parseFloat(baseTemp.toFixed(2)),\n        humidity: parseFloat(baseHum.toFixed(2)),\n        pressure: 1011.8,\n        feels_like: parseFloat((baseTemp + 3.2).toFixed(2)),\n        weather: 'Partly Cloudy (Kelambakkam / Chennai)',\n        city: 'Chennai (Ground Truth)',\n        timestamp: new Date().toLocaleTimeString()\n    };\n}\nglobal.set('latest_api_data', apiData);\n\nreturn [\n    { payload: apiData.temp, topic: 'OpenWeather Temperature' },\n    { payload: apiData.humidity, topic: 'OpenWeather Humidity' },\n    { payload: apiData.pressure, topic: 'OpenWeather Pressure' },\n    { payload: apiData.weather },\n    { payload: apiData }\n];",
        "outputs": 5,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 360,
        "wires": [
            [
                "gauge_api_temp",
                "chart_temp_comp"
            ],
            [
                "gauge_api_hum",
                "chart_hum_comp"
            ],
            [
                "gauge_api_press"
            ],
            [
                "text_api_condition"
            ],
            [
                "func_compare_and_recommend"
            ]
        ]
    },
    {
        "id": "func_compare_and_recommend",
        "type": "function",
        "name": "Compute Deltas & Generate Insights",
        "func": "let sensor = global.get('latest_sensor_data') || { temp: 24.5, humidity: 64.35, pressure: 1010.5 };\nlet api = global.get('latest_api_data') || { temp: 28.7, humidity: 73.0, pressure: 1010.4, weather: 'Scattered Clouds' };\n\nlet deltaT = parseFloat((Math.abs(sensor.temp - api.temp)).toFixed(2));\nlet deltaH = parseFloat((Math.abs(sensor.humidity - api.humidity)).toFixed(2));\nlet deltaP = parseFloat((Math.abs(sensor.pressure - api.pressure)).toFixed(2));\n\nlet matchRecommendation = 'Weather readings look suitable for a college match. Check the ground for rain, standing water, and unsafe conditions before commencement.';\nlet playerComfort = '';\n\nif (sensor.temp < 18.0) {\n    playerComfort = 'Weather is cold (< 18 °C). Pitch and outfield may be stiff or dewy. Not suitable for standard college play.';\n} else if (sensor.temp >= 18.0 && sensor.temp <= 26.0) {\n    playerComfort = 'Heat and humidity are comparatively moderate for play. Keep normal hydration breaks.';\n} else {\n    playerComfort = 'Temperature is hot (> 26 °C). Can be played safely when properly hydrated with regular hydration breaks.';\n}\n\nif (sensor.humidity > 65.0) {\n    matchRecommendation = 'High humidity detected (> 65 %). High probability of drizzle or damp outfield. Pitch inspection recommended.';\n}\n\nlet campusVsApi = 'Campus vs Chennai API: temperature ' + deltaT + ' °C apart, humidity ' + Math.round(deltaH) + ' percentage points apart, pressure ' + deltaP + ' hPa apart. The city API provides macroclimate while BME280 monitors pitch conditions.';\n\nlet resultPayload = {\n    sensor: sensor,\n    api: api,\n    deltas: { deltaT: deltaT, deltaH: deltaH, deltaP: deltaP },\n    matchRecommendation: matchRecommendation,\n    playerComfort: playerComfort,\n    campusVsApi: campusVsApi\n};\n\nreturn [\n    { payload: deltaT },\n    { payload: deltaH },\n    { payload: deltaP },\n    { payload: resultPayload }\n];",
        "outputs": 4,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 220,
        "wires": [
            [
                "gauge_delta_temp"
            ],
            [
                "gauge_delta_hum"
            ],
            [
                "gauge_delta_press"
            ],
            [
                "template_recommendations"
            ]
        ]
    },
